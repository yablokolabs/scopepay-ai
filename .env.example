# ScopePay environment variable names.
# Copy to .env (git-ignored) or set these in the hosting provider's secret store.
# Never commit real values, never paste them into chat, issues or screenshots.

# --- CSCS inference (Apertus brief-to-scope extraction) ---
# Verified reachable from the build host: GET /models -> 200, chat completion -> 200.
CSCS_INFERENCE_API_KEY=
CSCS_BASE_URL=https://api.inference.cscs.ch/v1
CSCS_MODEL=swiss-ai/Apertus-v1.5-70B

# --- PayPal Sandbox (REST app) ---
# Create at https://developer.paypal.com/dashboard/applications/sandbox
# Client ID is publishable configuration; the secret must stay server-side only.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# PayPal's own payee merchant id for this sandbox app, as returned by
# GET /v2/checkout/orders -> purchase_units[].payee.merchant_id. This is NOT the
# human-readable MERCHANT_ID below; capture compares the payee against this value
# and reports the match as unverified when it is unset.
PAYPAL_MERCHANT_ID=
# Value sent/verified in the Paypal-Request-Id header for order-creation idempotency.
PAYPAL_IDEMPOTENCY_KEY_PREFIX=scopepay

# --- Merchant of record for this sandbox build ---
# The single sandbox merchant whose catalog and PayPal app ScopePay is configured for.
MERCHANT_ID=sandbox-merchant-1
MERCHANT_NAME=

# --- Runtime ---
PORT=8790
SCOPEPAY_STORE=file
# Origin that serves the CLIENT, not this API: PayPal returns the buyer's browser
# to {PUBLIC_BASE_URL}/checkout/return, a client route. The API answers 404 on
# /checkout/*, so pointing this at the API leaves the buyer with an error page
# after a successful approval. Defaults to the local client origin below; set it
# explicitly for any deployment (and use the same value for the webhook URL).
PUBLIC_BASE_URL=http://localhost:5173
